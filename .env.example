VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_API_BASE_URL=https://api.example.com
VITE_EXPIRATION_HOURS=24
VITE_MIN_AMOUNT=0.001
VITE_MAX_AMOUNT=10
VITE_EVM_CONFIRMATIONS=2
VITE_EVM_CONFIRMATIONS_USD_AMOUNT=1000
VITE_BTC_CONFIRMATIONS=6

# ERC-2771 Gas Station Relayer
# Set this to enable gas-free reservePosition() calls via FlorinForwarder (OZ ERC2771Forwarder v5).
# If unset, falls back to direct on-chain calls (user pays ETH gas).
# VITE_RELAYER_URL=http://localhost:3001
